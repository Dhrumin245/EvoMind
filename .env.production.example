EVOMIND_POSTGRES_DB=evomind
EVOMIND_POSTGRES_USER=evomind
EVOMIND_POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
EVOMIND_WEBHOOK_SECRET_KEY_FILE=./secrets/webhook_secret_key.txt
EVOMIND_CONTROL_PLANE_DB_SSLMODE=disable
EVOMIND_CORS_ALLOW_ORIGINS=https://app.example.com,http://localhost:3000,http://127.0.0.1:3000
EVOMIND_SITE_ADDRESS=api.example.com
EVOMIND_FRONTEND_URL=https://app.example.com
EVOMIND_LOG_LEVEL=INFO
EVOMIND_RAZORPAY_KEY_ID=
EVOMIND_RAZORPAY_KEY_SECRET=
EVOMIND_RAZORPAY_WEBHOOK_SECRET=
EVOMIND_RAZORPAY_BASE_URL=https://api.razorpay.com
VITE_API_BASE_URL=/api
